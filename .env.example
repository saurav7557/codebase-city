# PostgreSQL connection used only by server-side Prisma code.
# Replace the credentials and database name for your local installation.
DATABASE_URL="postgresql://codebase_city:replace-with-a-local-password@localhost:5432/codebase_city?schema=public"

# Optional: raises GitHub API rate limits for server-side public API requests.
# Never use a NEXT_PUBLIC_ variable for this token.
GITHUB_TOKEN=""

# Optional AI interpretation. AI stays server-side and is never required for the
# application to build or run. When configured, use only one supported provider.
AI_PROVIDER=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
